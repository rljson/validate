{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "@rljson/validate",

  // 1-2 sentence summary about this repo.
  "summary": "validate(rljson): runs the BaseValidator of @rljson/rljson and returns a ValidationResult; re-exports Validate, BaseValidator, ValidationResult.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "structural validation of Rljson data",
    "thin wrapper: the validators live in @rljson/rljson"
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {
      "rljson": "Validate, BaseValidator, ValidationResult, Rljson"
    },

    // "<repo-b>": "why / API"
    "usedBy": {}
  }
}
